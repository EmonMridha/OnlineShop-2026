model Product {
    id          String      @id @default(cuid())
    name        String
    description String
    price       Decimal     @db.Decimal(10, 2)
    imageURL    String
    stock       Int         @default(0)
    orderItems  OrderItem[]
    isActive    Boolean     @default(true)
    createdAt   DateTime    @default(now())
    updatedAt   DateTime    @updatedAt
}
