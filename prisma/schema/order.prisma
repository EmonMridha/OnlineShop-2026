enum OrderStatus {
    PENDING
    CONFIRMED
    SHIPPED
    DELIVERED
    CANCELLED
}

model Order {
    id           String      @id @default(cuid())
    customerName String
    phone        String
    address      String
    total        Decimal     @db.Decimal(10, 2)
    status       OrderStatus @default(PENDING)
    items        OrderItem[]
    createdAt    DateTime    @default(now())
    updatedAt    DateTime    @updatedAt
}
